{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "linkhat",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-04",
  "workers_dev": false,
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/_"],
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
  },
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
}
